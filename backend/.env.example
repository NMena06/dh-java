# Copiar este archivo como backend/.env y completar los valores. Todos son opcionales:
# si no se definen, se usan los valores por defecto de application.properties.
# Nunca subir el archivo .env al repositorio (esta en .gitignore).

# Puerto del backend
SERVER_PORT=8080

# Base de datos (H2 en archivo, base "reservaya", se crea sola en backend/data/)
DB_URL=jdbc:h2:file:./data/reservaya;AUTO_SERVER=TRUE
DB_USERNAME=sa
DB_PASSWORD=
H2_CONSOLE_ENABLED=true

# URL del frontend (enlaces de los correos) y origenes permitidos por CORS (separados por coma)
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Duracion de la sesion en horas
SESSION_HOURS=8

# Administrador inicial (se crea al arrancar si no hay usuarios)
ADMIN_EMAIL=admin@reservaya.com
ADMIN_PASSWORD=cambiar-esta-clave

# Contacto del proveedor que aparece en la confirmacion y el correo de reserva
PROVIDER_NAME=ReservaYa Atencion al cliente
PROVIDER_EMAIL=contacto@ejemplo.com
PROVIDER_PHONE=+54 9 11 0000-0000

# Correo SMTP. Si MAIL_HOST queda vacio, los correos se muestran en el log del backend.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=tu-cuenta@ejemplo.com
MAIL_PASSWORD=clave-de-aplicacion
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_FROM=tu-cuenta@ejemplo.com

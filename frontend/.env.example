# Copiar como frontend/.env (o .env.local) y ajustar. Todas son opcionales.
# Nunca subir el archivo .env al repositorio.

# URL base de la API. Si no se define se usa "/api" y Vite la redirige a http://localhost:8080.
VITE_API_URL=http://localhost:8080/api

# Nombre que se muestra en el botón de WhatsApp
VITE_APP_NAME=ReservaYa

# Número de WhatsApp del proveedor (historia #34), con código de país y sin "+", espacios ni guiones.
# Reemplazar por un número real; el de ejemplo no existe.
VITE_WHATSAPP_NUMBER=5491100000000
